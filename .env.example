# noop-cloud configuration. Copy to `.env` and edit. `.env` is gitignored (holds secrets).

# ── required ──────────────────────────────────────────────────────────────────
# Trust anchor for approving a device pairing on the /pair page. Change it; keep it secret.
PAIR_ADMIN_PIN=change-me

# ── networking ────────────────────────────────────────────────────────────────
# Bind the API to localhost only (default) until first-run setup is done; set 0.0.0.0 for the LAN.
API_BIND=127.0.0.1
# The self-signed HTTPS app-link listener (:8443) binds here (default LAN).
TLS_BIND=0.0.0.0

# ── TLS / security (optional) ─────────────────────────────────────────────────
# Serve the app link over self-signed HTTPS on :8443 (the app pins the cert).
TLS_ENABLED=
# Require the app's mutual-TLS client cert on data routes (hardened; needs TLS_ENABLED).
MTLS_REQUIRED=
# Cert signature algorithm: ec (default, universal) · rsa · mldsa65 (post-quantum — verify your
# device's TLS can do ML-DSA before enabling, else the app can't complete the handshake).
CERT_ALG=ec
# Bind a link to a unique client id (device+strap) and reject a token replayed elsewhere (default on).
REQUIRE_CLIENT_ID=1
# Forgotten admin password: set FORGOT_PASSWORD=1 (+ optional ADMIN_RESET_PASSWORD) and restart.
FORGOT_PASSWORD=
ADMIN_RESET_PASSWORD=

# ── AI coach (optional) ───────────────────────────────────────────────────────
# Universal OpenAI-compatible. Point at OpenAI, Groq, OpenRouter, or a local Ollama (http://host:11434/v1).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
